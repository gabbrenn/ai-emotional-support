{
  "name": "ai-emotional-support",
  "version": "1.0.0",
  "private": true,
  "description": "AI Emotional Support Assistant - Monorepo",
  "scripts": {
    "dev": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,magenta\" \"pnpm --filter @ai-esa/api dev\" \"pnpm --filter @ai-esa/web dev\"",
    "build": "pnpm --filter @ai-esa/api build && pnpm --filter @ai-esa/web build",
    "lint": "pnpm --filter @ai-esa/api lint && pnpm --filter @ai-esa/web lint",
    "db:generate": "pnpm --filter @ai-esa/api db:generate",
    "db:migrate": "pnpm --filter @ai-esa/api db:migrate"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
