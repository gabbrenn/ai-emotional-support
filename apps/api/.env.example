# Application
NODE_ENV=development
PORT=3040

# Database (SQLite file path relative to project root)
DATABASE_URL=./data/app.db

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret

# AI Provider (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Notify Key
NOTIFY_API_URL=https://notify-api.afrisinc.com/api/notify/send
NOTIFY_KEY=

# Frontend URL (used by backend for CORS)
FRONTEND_URL=http://localhost:5173

# Initial Administrator Bootstrap
# The initial administrator is automatically created when the API starts
# if no administrator exists. Never commit real ADMIN_PASSWORD values.
ADMIN_NAME=MindCare Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
