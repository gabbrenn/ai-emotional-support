{
  "name": "@ai-esa/api",
  "version": "1.0.0",
  "private": true,
  "description": "AI Emotional Support Assistant — Fastify API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
